//@version=5
// ============================================================
//  Smart Scalper Multi-Asset - Prop Firm Risk Model
//
//  Assets    : Crypto volatile (1m/5m) + Forex majors (1m/5m)
//  Style     : Scalping trend-following, anti-fakeout, capital-safe
//
//  SETUP DE BASE (3 etages, confluence stricte)
//  1) TENDANCE  : EMA200 / VWAP / les deux (filtre flux macro)
//  2) MOMENTUM  : RSI au-dessus/dessous d'un seuil + volume > MA
//  3) TRIGGER   : Bougie englobante OU cassure de structure HH/LL
//
//  GESTION DU RISQUE (style Prop Firm)
//  - Risk fixe par trade (% equity)         -> sizing dynamique
//  - SL = ATR x multiplicateur              -> s'adapte a la volatilite
//  - TP = SL x R/R (>= 1.5)                 -> esperance positive
//  - Trailing stop ATR optionnel            -> securise les gains
//  - Kill switch journalier (% drawdown)    -> protege le compte
//  - Cooldown entre trades                  -> evite l'overtrading
//  - Frais Taker realistes integres au backtest
// ============================================================

strategy("Smart Scalper Multi-Asset - Prop Firm Risk", shorttitle="Smart Scalper", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.04, slippage=2, margin_long=1, margin_short=1, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true)


// ============================================================
//                           INPUTS
// ============================================================

// 1. Risk Management
riskPct         = input.float(0.5, "Risk % par trade",                     group="1. Risk Management (Prop Firm)", step=0.1, minval=0.1, maxval=5.0, tooltip="% de l'equity risque par trade. 0.5-1% pour respecter les regles Prop Firm.")
maxDailyLossPct = input.float(3.0, "Max daily loss % (kill switch)",       group="1. Risk Management (Prop Firm)", step=0.5, minval=1.0, maxval=20.0, tooltip="Si la perte cumulee du jour atteint ce %, aucun nouveau trade pour la journee. Le coupe-circuit Prop Firm classique.")
maxTradesDay    = input.int(8,     "Max trades par jour",                  group="1. Risk Management (Prop Firm)", minval=1,   maxval=50, tooltip="Plafond du nombre d'entrees quotidiennes. Anti-overtrading.")

// 2. Trend Filter
trendMode = input.string("EMA200", "Filtre de tendance", options=["EMA200", "VWAP", "Both"], group="2. Filtre de Tendance", tooltip="EMA200 = multi-asset, VWAP = ancrage intraday (crypto/indices), Both = strict.")
emaLen    = input.int(200, "Longueur EMA", group="2. Filtre de Tendance", minval=10)

// 3. Momentum & Volume
rsiLen       = input.int(14,   "Periode RSI",                        group="3. Momentum & Volume", minval=2)
rsiBullLvl   = input.float(50, "RSI seuil bull (long si RSI >)",     group="3. Momentum & Volume", step=1, minval=30, maxval=70, tooltip="50 = standard. Augmenter pour signaux plus forts.")
rsiBearLvl   = input.float(50, "RSI seuil bear (short si RSI <)",    group="3. Momentum & Volume", step=1, minval=30, maxval=70)
useVolFilter = input.bool(true,"Filtre de volume (anti-fakeout)",    group="3. Momentum & Volume", tooltip="Le volume du signal doit etre > MA(volume) * facteur.")
volMaLen     = input.int(20,   "MA du volume",                       group="3. Momentum & Volume", minval=1)
volMult      = input.float(1.2,"Volume requis x MA",                 group="3. Momentum & Volume", step=0.1, minval=1.0)

// 4. Trigger
trigMode  = input.string("Engulfing", "Type de trigger", options=["Engulfing", "Structure Break"], group="4. Trigger d'Entree", tooltip="Engulfing = bougie englobante (price action pure), Structure Break = cassure HH/LL des N dernieres bougies.")
structLen = input.int(10, "Lookback structure (si Structure Break)", group="4. Trigger d'Entree", minval=2)

// 5. SL & TP
atrLen       = input.int(14,    "Periode ATR",                  group="5. Stop Loss & Take Profit", minval=1)
atrSlMult    = input.float(1.5, "Multiplicateur ATR pour SL",   group="5. Stop Loss & Take Profit", step=0.1, minval=0.5, tooltip="SL place a (multiplicateur x ATR) du prix d'entree. 1.5 = standard.")
rrRatio      = input.float(1.5, "Ratio R/R (TP = R/R x SL)",    group="5. Stop Loss & Take Profit", step=0.1, minval=1.0, tooltip="Minimum 1.5 pour rester rentable apres frais (winrate 50% suffit).")
useTrailing  = input.bool(false,"Activer trailing stop ATR",    group="5. Stop Loss & Take Profit", tooltip="Si actif, le SL trail derriere le prix favorable a (multiplicateur x ATR), sans jamais s'elargir.")
trailAtrMult = input.float(1.0, "Multiplicateur ATR trailing",  group="5. Stop Loss & Take Profit", step=0.1, minval=0.5)

// 6. Session & Pacing
useSession   = input.bool(false,         "Filtrer par session (Forex)",   group="6. Session & Pacing", tooltip="Crypto = laisse off (24/7). Forex/indices = active et regle.")
sessionStr   = input.session("0800-2000","Session active (UTC)",          group="6. Session & Pacing", tooltip="Forex Londres+NY : 0800-2000 UTC. Forex Londres : 0800-1700.")
cooldownBars = input.int(3,              "Cooldown apres trade (bougies)",group="6. Session & Pacing", minval=0)

// 7. Frais (rappel)
showFeeNote = input.bool(true, "Frais : 0.04% taker (modif. dans strategy())", group="7. Frais", tooltip="Pour ajuster les frais, modifie 'commission_value=0.04' dans la 1ere ligne strategy().")


// ============================================================
//                       INDICATEURS
// ============================================================

emaTrend = ta.ema(close, emaLen)
vwapVal  = ta.vwap
rsiVal   = ta.rsi(close, rsiLen)
atrVal   = ta.atr(atrLen)
volMa    = ta.sma(volume, volMaLen)


// ============================================================
//                     FILTRE DE TENDANCE
// ============================================================

trendUp = trendMode == "EMA200" ? close > emaTrend : trendMode == "VWAP" ? close > vwapVal : (close > emaTrend and close > vwapVal)
trendDn = trendMode == "EMA200" ? close < emaTrend : trendMode == "VWAP" ? close < vwapVal : (close < emaTrend and close < vwapVal)


// ============================================================
//                     MOMENTUM & VOLUME
// ============================================================

momBull = rsiVal > rsiBullLvl
momBear = rsiVal < rsiBearLvl
volOk   = not useVolFilter or volume > volMa * volMult


// ============================================================
//                         TRIGGERS
// ============================================================

// Bougie englobante haussiere / baissiere
bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

// Cassure de structure (Donchian HH/LL des N bougies precedentes)
hh = ta.highest(high, structLen)[1]
ll = ta.lowest(low,   structLen)[1]
structUp = ta.crossover(close, hh)
structDn = ta.crossunder(close, ll)

trigUp = trigMode == "Engulfing" ? bullEngulf : structUp
trigDn = trigMode == "Engulfing" ? bearEngulf : structDn


// ============================================================
//                         SESSION
// ============================================================

inSession = not useSession or not na(time(timeframe.period, sessionStr))


// ============================================================
//          KILL SWITCH JOURNALIER + COMPTE TRADES
// ============================================================

var float dayStartEquity = na
var int   dailyTrades    = 0

newDay = ta.change(time("D")) != 0
if newDay or na(dayStartEquity)
    dayStartEquity := strategy.equity
    dailyTrades    := 0

dailyLossPct = na(dayStartEquity) ? 0.0 : ((dayStartEquity - strategy.equity) / dayStartEquity) * 100.0
killOk       = dailyLossPct < maxDailyLossPct
tradeCapOk   = dailyTrades < maxTradesDay


// ============================================================
//                         COOLDOWN
// ============================================================

var int lastExitBar = -10000
if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index
cooldownOk = (bar_index - lastExitBar) >= cooldownBars


// ============================================================
//                         SIGNAUX
// ============================================================

longSignal  = trendUp and momBull and volOk and trigUp and inSession and killOk and tradeCapOk and cooldownOk
shortSignal = trendDn and momBear and volOk and trigDn and inSession and killOk and tradeCapOk and cooldownOk


// ============================================================
//        SIZING DYNAMIQUE (RISK FIXE PAR TRADE)
// ============================================================
//  qty = risk_$ / SL_distance
//  -> SL hit = perte exacte = riskPct de l'equity
//  -> valable crypto, forex, indices (asset-agnostic)

slDist   = atrSlMult * atrVal
tpDist   = slDist * rrRatio
riskUsd  = strategy.equity * riskPct / 100.0
qtyUnits = (slDist > 0 and atrVal > 0) ? riskUsd / slDist : 0.0


// ============================================================
//                       EXECUTION
// ============================================================
//  SL/TP fixes initiaux poses au bar d'entree.
//  Trailing ne fait que TIGHTEN le SL (jamais l'elargir).

var float fixedSl = na
var float fixedTp = na

if longSignal and strategy.position_size == 0 and qtyUnits > 0
    strategy.entry("Long", strategy.long, qty=qtyUnits)
    fixedSl := close - slDist
    fixedTp := close + tpDist
    strategy.exit("XL", from_entry="Long", limit=fixedTp, stop=fixedSl)
    dailyTrades := dailyTrades + 1

if shortSignal and strategy.position_size == 0 and qtyUnits > 0
    strategy.entry("Short", strategy.short, qty=qtyUnits)
    fixedSl := close + slDist
    fixedTp := close - tpDist
    strategy.exit("XS", from_entry="Short", limit=fixedTp, stop=fixedSl)
    dailyTrades := dailyTrades + 1

// Trailing : resserre uniquement (math.max pour long, math.min pour short)
if useTrailing and strategy.position_size > 0
    trailSl  = high - trailAtrMult * atrVal
    activeSl = math.max(fixedSl, trailSl)
    strategy.exit("XL", from_entry="Long", limit=fixedTp, stop=activeSl)

if useTrailing and strategy.position_size < 0
    trailSl  = low + trailAtrMult * atrVal
    activeSl = math.min(fixedSl, trailSl)
    strategy.exit("XS", from_entry="Short", limit=fixedTp, stop=activeSl)


// ============================================================
//                         VISUELS
// ============================================================

plot(trendMode == "EMA200" or trendMode == "Both" ? emaTrend : na, title="EMA200", color=color.new(color.orange, 0), linewidth=2)
plot(trendMode == "VWAP"   or trendMode == "Both" ? vwapVal  : na, title="VWAP",   color=color.new(color.aqua,   0), linewidth=2)

plotshape(longSignal,  title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(shortSignal, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,  0), size=size.small)

plot(strategy.position_size != 0 ? fixedTp : na, title="TP", color=color.new(color.green, 20), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size != 0 ? fixedSl : na, title="SL", color=color.new(color.red,   20), style=plot.style_linebr, linewidth=1)

// Kill switch visuel (fond rouge si la journee est coupee)
bgcolor(not killOk ? color.new(color.red, 88) : na, title="Kill Switch")


// ============================================================
//                         ALERTES
// ============================================================

alertcondition(longSignal,  title="LONG entry",  message="LONG {{ticker}} @ {{close}}")
alertcondition(shortSignal, title="SHORT entry", message="SHORT {{ticker}} @ {{close}}")
