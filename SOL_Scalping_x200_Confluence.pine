//@version=5
// ============================================================
//  Smart Scalper - 5m/1m Optimized (Multi-Asset, Prop Firm)
//
//  POURQUOI CETTE VERSION FONCTIONNE EN 5m MAX :
//  - EMA200 abandonnee (16h de lag en 5m, inutile pour scalping)
//  - Tendance lue en MULTI-TF : EMA9/21 sur le TF superieur
//    (15m par defaut), ce qui filtre le bruit du 5m sans tuer
//    la reactivite
//  - RSI 7 + MACD histogram = momentum reactif
//  - Donchian 8 bars + volume = trigger frequent mais filtre
//  - ATR x 1.0 (SL serre) avec R/R 2.0 (TP plus large, absorbe
//    les frais : breakeven mathematique 50% winrate)
//  - Trailing actif APRES +1R favorable = ne coupe pas les
//    runners, securise les BE
//  - Kill switch + daily cap + cooldown (Prop Firm safe)
// ============================================================

strategy("Smart Scalper 5m - Prop Firm Risk", shorttitle="Scalper 5m", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.04, slippage=2, margin_long=1, margin_short=1, pyramiding=0, calc_on_every_tick=false, process_orders_on_close=true)


// ============================================================
//                           INPUTS
// ============================================================

// 1. Risk Management
riskPct         = input.float(0.5, "Risk % par trade",                group="1. Risk Management",  step=0.1, minval=0.1, maxval=5.0,  tooltip="% de l'equity risque par trade. 0.5-1% = standard Prop Firm.")
maxDailyLossPct = input.float(3.0, "Max daily loss % (kill switch)",  group="1. Risk Management",  step=0.5, minval=1.0, maxval=20.0, tooltip="Au-dela de ce drawdown du jour, plus aucun nouveau trade.")
maxTradesDay    = input.int(10,    "Max trades par jour",             group="1. Risk Management",  minval=1, maxval=50, tooltip="Plafond anti-overtrading. 10 = correct pour 5m, 20 pour 1m.")

// 2. Tendance Multi-TF (CLE pour rentabilite en 5m)
useMtfTrend = input.bool(true,        "Activer filtre MTF (recommande)",  group="2. Tendance Multi-TF",  tooltip="OFF = trend lu sur le chart TF. ON = trend lu sur TF superieur (recommande pour 1m/5m).")
mtfTrendTf  = input.timeframe("15",   "TF tendance",  options=["5","15","30","60"], group="2. Tendance Multi-TF",  tooltip="Pour chart 1m -> 5m ou 15m. Pour chart 5m -> 15m ou 30m. Ratio ~3x du chart TF.")
emaFastLen  = input.int(9,            "EMA rapide (sur TF tendance)",     group="2. Tendance Multi-TF",  minval=2)
emaSlowLen  = input.int(21,           "EMA lente (sur TF tendance)",      group="2. Tendance Multi-TF",  minval=2)
useVwap     = input.bool(true,        "Confirmer par VWAP (chart TF)",    group="2. Tendance Multi-TF",  tooltip="VWAP intraday comme ancrage prix. Tres efficace en scalping crypto.")

// 3. Momentum & Volume (scalping-tuned)
rsiLen       = input.int(7,    "Periode RSI (rapide)",            group="3. Momentum & Volume", minval=2, tooltip="7 = reactif scalping (vs 14 classique).")
rsiBullLvl   = input.float(50, "RSI seuil bull (long si RSI >)",  group="3. Momentum & Volume", step=1, minval=30, maxval=70)
rsiBearLvl   = input.float(50, "RSI seuil bear (short si RSI <)", group="3. Momentum & Volume", step=1, minval=30, maxval=70)
useMacd      = input.bool(true,"Filtre MACD histogram",           group="3. Momentum & Volume", tooltip="Le histogram MACD doit etre du bon cote (>0 pour long, <0 pour short).")
useVolFilter = input.bool(true,"Filtre de volume (anti-fakeout)", group="3. Momentum & Volume", tooltip="Le volume du signal doit etre > MA(volume) * facteur.")
volMaLen     = input.int(20,   "MA volume",                       group="3. Momentum & Volume", minval=1)
volMult      = input.float(1.3,"Volume requis x MA",              group="3. Momentum & Volume", step=0.1, minval=1.0)

// 4. Trigger (Donchian breakout, plus frequent qu'engulfing)
breakoutLen = input.int(8, "Lookback breakout Donchian (bougies)", group="4. Trigger d'Entree", minval=2, tooltip="8 = scalping standard. 5 = ultra-reactif (1m), 12 = filtre supplementaire.")

// 5. SL & TP (tight scalping post-fees)
atrLen           = input.int(14,    "Periode ATR",                       group="5. SL & TP", minval=1)
atrSlMult        = input.float(1.0, "Multiplicateur ATR pour SL",        group="5. SL & TP", step=0.1, minval=0.5, tooltip="1.0 = scalping serre. Augmenter pour assets plus volatils.")
rrRatio          = input.float(2.0, "Ratio R/R (TP = R/R x SL)",         group="5. SL & TP", step=0.1, minval=1.0, tooltip="2.0 = absorbe les frais 0.04% x 2. Permet 50% winrate breakeven.")
useTrailing      = input.bool(true, "Trailing stop apres mouvement +R",  group="5. SL & TP", tooltip="Active le trailing UNIQUEMENT apres que le prix ait bouge de X x R en favorable.")
trailActivationR = input.float(1.0, "Trailing actif apres X x R",        group="5. SL & TP", step=0.1, minval=0.5, tooltip="1.0 = trailing demarre quand on est a +1R (BE secure).")
trailAtrMult     = input.float(0.8, "Multiplicateur ATR trailing",       group="5. SL & TP", step=0.1, minval=0.5, tooltip="Distance trailing en ATR. 0.8 = laisse respirer, 0.5 = serre.")

// 6. Session & Pacing
useSession   = input.bool(false,         "Filtrer par session (Forex)",   group="6. Session & Pacing", tooltip="Crypto = off (24/7). Forex = on et regle Londres+NY.")
sessionStr   = input.session("0700-2000","Session UTC active",            group="6. Session & Pacing")
cooldownBars = input.int(2,              "Cooldown apres trade (bougies)",group="6. Session & Pacing", minval=0)

// 7. Frais (rappel)
showFeeNote = input.bool(true, "Frais 0.04% taker (modif. dans strategy())", group="7. Frais", tooltip="Pour Bybit/Binance taker = 0.04-0.06%. Adapte 'commission_value' ligne 1.")


// ============================================================
//                INDICATEURS (chart TF)
// ============================================================

vwapVal = ta.vwap
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
volMa   = ta.sma(volume, volMaLen)
[macdLine, macdSig, macdHist] = ta.macd(close, 12, 26, 9)


// ============================================================
//        TENDANCE MULTI-TF (EMA9/21 sur TF superieur)
// ============================================================

f_mtfTrend() =>
    eF = ta.ema(close, emaFastLen)
    eS = ta.ema(close, emaSlowLen)
    [eF, eS]

mtfTfActual = useMtfTrend ? mtfTrendTf : timeframe.period
[mtfEmaFast, mtfEmaSlow] = request.security(syminfo.tickerid, mtfTfActual, f_mtfTrend(), lookahead=barmerge.lookahead_off)


// ============================================================
//                       CONDITIONS
// ============================================================

trendUp = mtfEmaFast > mtfEmaSlow and (not useVwap or close > vwapVal)
trendDn = mtfEmaFast < mtfEmaSlow and (not useVwap or close < vwapVal)

momBull = rsiVal > rsiBullLvl and (not useMacd or macdHist > 0)
momBear = rsiVal < rsiBearLvl and (not useMacd or macdHist < 0)

volOk = not useVolFilter or volume > volMa * volMult

hh = ta.highest(high, breakoutLen)[1]
ll = ta.lowest(low,   breakoutLen)[1]
trigUp = ta.crossover(close, hh)
trigDn = ta.crossunder(close, ll)

inSession = not useSession or not na(time(timeframe.period, sessionStr))


// ============================================================
//        KILL SWITCH JOURNALIER + CAP TRADES
// ============================================================

var float dayStartEquity = na
var int   dailyTrades    = 0

newDay = ta.change(time("D")) != 0
if newDay or na(dayStartEquity)
    dayStartEquity := strategy.equity
    dailyTrades    := 0

dailyLossPct = na(dayStartEquity) ? 0.0 : ((dayStartEquity - strategy.equity) / dayStartEquity) * 100.0
killOk       = dailyLossPct < maxDailyLossPct
tradeCapOk   = dailyTrades < maxTradesDay


// ============================================================
//                       COOLDOWN
// ============================================================

var int lastExitBar = -10000
if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastExitBar := bar_index
cooldownOk = (bar_index - lastExitBar) >= cooldownBars


// ============================================================
//                       SIGNAUX
// ============================================================

longSignal  = trendUp and momBull and volOk and trigUp and inSession and killOk and tradeCapOk and cooldownOk
shortSignal = trendDn and momBear and volOk and trigDn and inSession and killOk and tradeCapOk and cooldownOk


// ============================================================
//                 SIZING DYNAMIQUE (RISK FIXE)
// ============================================================

slDist   = atrSlMult * atrVal
tpDist   = slDist * rrRatio
riskUsd  = strategy.equity * riskPct / 100.0
qtyUnits = (slDist > 0 and atrVal > 0) ? riskUsd / slDist : 0.0


// ============================================================
//                     EXECUTION + TRAILING
// ============================================================

var float fixedSl    = na
var float fixedTp    = na
var float entryPrice = na

if longSignal and strategy.position_size == 0 and qtyUnits > 0
    strategy.entry("Long", strategy.long, qty=qtyUnits)
    entryPrice := close
    fixedSl    := close - slDist
    fixedTp    := close + tpDist
    strategy.exit("XL", from_entry="Long", limit=fixedTp, stop=fixedSl)
    dailyTrades := dailyTrades + 1

if shortSignal and strategy.position_size == 0 and qtyUnits > 0
    strategy.entry("Short", strategy.short, qty=qtyUnits)
    entryPrice := close
    fixedSl    := close + slDist
    fixedTp    := close - tpDist
    strategy.exit("XS", from_entry="Short", limit=fixedTp, stop=fixedSl)
    dailyTrades := dailyTrades + 1

// Trailing : active SEULEMENT apres mouvement favorable >= trailActivationR x R
if useTrailing and strategy.position_size > 0
    favorableMove  = high - entryPrice
    activationDist = slDist * trailActivationR
    if favorableMove >= activationDist
        trailSl  = high - trailAtrMult * atrVal
        activeSl = math.max(fixedSl, trailSl)
        strategy.exit("XL", from_entry="Long", limit=fixedTp, stop=activeSl)

if useTrailing and strategy.position_size < 0
    favorableMove  = entryPrice - low
    activationDist = slDist * trailActivationR
    if favorableMove >= activationDist
        trailSl  = low + trailAtrMult * atrVal
        activeSl = math.min(fixedSl, trailSl)
        strategy.exit("XS", from_entry="Short", limit=fixedTp, stop=activeSl)


// ============================================================
//                       VISUELS
// ============================================================

plot(useVwap ? vwapVal : na, title="VWAP", color=color.new(color.aqua, 0), linewidth=2)
plot(mtfEmaFast, title="EMA fast (MTF)", color=color.new(color.yellow, 30))
plot(mtfEmaSlow, title="EMA slow (MTF)", color=color.new(color.orange, 30), linewidth=2)

plotshape(longSignal,  title="Long",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(shortSignal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,  0), size=size.small)

plot(strategy.position_size != 0 ? fixedTp : na, title="TP", color=color.new(color.green, 20), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size != 0 ? fixedSl : na, title="SL", color=color.new(color.red,   20), style=plot.style_linebr, linewidth=1)

// Fond colore : rouge = kill switch active, vert/rouge tres pale = etat trend MTF
bgcolor(not killOk ? color.new(color.red, 88) : trendUp ? color.new(color.lime, 96) : trendDn ? color.new(color.red, 96) : na, title="Etat")


// ============================================================
//                       ALERTES
// ============================================================

alertcondition(longSignal,  title="LONG entry",  message="LONG {{ticker}} @ {{close}}")
alertcondition(shortSignal, title="SHORT entry", message="SHORT {{ticker}} @ {{close}}")
