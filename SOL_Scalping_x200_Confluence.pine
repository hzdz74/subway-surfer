//@version=5
// ============================================================
//  SOL Breakout x200 - RSI Filter Strategy
//  Asset      : SOLUSDT.P
//  Logique    : Cassure (close) du canal Donchian HH/LL des N
//               dernieres bougies, filtree par RSI dans [30 ; 70].
//  Cible      : TP +0.125% prix = +25% ROE @ x200
//               SL -0.0625% prix = -12.5% ROE  (R/R 2:1)
//               Liquidation a ~ -0.5% prix
// ============================================================

strategy(
     title                   = "SOL Breakout x200 - RSI Filter",
     shorttitle              = "SOL Brk x200",
     overlay                 = true,
     initial_capital         = 1000,
     currency                = currency.USD,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.05,
     slippage                = 2,
     margin_long             = 0.5,
     margin_short            = 0.5,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true)


// ============================================================
//                           INPUTS
// ============================================================

// 0. Timeframe d'analyse
tfChoice = input.timeframe("5", "Timeframe d'analyse",
                            options = ["1", "5"], group = "0. Timeframe",
                            tooltip = "1 = 1m, 5 = 5m. La strategie opere sur ce TF via request.security, quel que soit le TF du chart. Astuce : mettez le chart sur le meme TF ou plus bas.")

// 1. Breakout (canal Donchian)
breakoutLen = input.int(20, "Longueur du canal (bougies HH/LL)",
                            group = "1. Breakout", minval = 2,
                            tooltip = "Nombre de bougies pour definir le plus haut / plus bas a casser. 10 = reactif (signaux frequents), 20 = robuste (defaut), 50 = swing.")

// 2. Filtre RSI strict
rsiLen   = input.int(14,    "Periode RSI",                   group = "2. RSI Filter", minval = 2)
rsiLower = input.float(30,  "Borne basse RSI (interdit si <)",group = "2. RSI Filter", step = 1, minval = 0,  maxval = 100,
                            tooltip = "Aucun trade si RSI < cette valeur (zone de survente extreme).")
rsiUpper = input.float(70,  "Borne haute RSI (interdit si >)",group = "2. RSI Filter", step = 1, minval = 0,  maxval = 100,
                            tooltip = "Aucun trade si RSI > cette valeur (zone de surachat extreme).")

// 3. Gestion du risque
tpPct = input.float(0.125, "Take Profit %  (+25% ROE @ x200)",
                           group = "3. Risque", step = 0.005, minval = 0.001,
                           tooltip = "0.125% de mouvement prix = +25% ROE sur position x200.")
slPct = input.float(0.0625,"Stop Loss %  (R/R 2:1, -12.5% ROE)",
                           group = "3. Risque", step = 0.005, minval = 0.001,
                           tooltip = "0.0625% prix = -12.5% ROE. Doit rester < 0.5% (liquidation x200). Augmenter pour structure-based.")

// 4. Position sizing
qtyPct  = input.float(10,  "Marge par trade (% equity)",    group = "4. Sizing", step = 1, minval = 0.1)
levInfo = input.float(200, "Levier (sizing notionnel)",     group = "4. Sizing", minval = 1)

// 5. Pacing
useCooldown  = input.bool(true, "Cooldown entre trades",    group = "5. Pacing")
cooldownBars = input.int(2,     "Cooldown (bougies)",       group = "5. Pacing", minval = 0)


// ============================================================
//          INDICATEURS (evalues au TF choisi)
// ============================================================
//  Pour eviter tout biais d'avenir, on utilise lookahead_off :
//  request.security retourne la valeur de la DERNIERE bougie
//  CLOTUREE du TF demande.

f_calc() =>
    hh        = ta.highest(high, breakoutLen)[1]   // [1] = exclure la bougie courante
    ll        = ta.lowest(low,   breakoutLen)[1]
    rsi       = ta.rsi(close, rsiLen)
    longTrig  = ta.crossover(close,  hh)
    shortTrig = ta.crossunder(close, ll)
    [hh, ll, rsi, longTrig, shortTrig]

[hhTf, llTf, rsiTf, longTrigTf, shortTrigTf] = request.security(syminfo.tickerid, tfChoice, f_calc(),
                                                                  lookahead = barmerge.lookahead_off)


// ============================================================
//                        CONDITIONS
// ============================================================

// Flanc montant : on n'entre QUE sur la chart bar ou le trigger
// devient true (evite les re-entrees pendant la duree d'une bougie HTF).
newLong  = longTrigTf  and not longTrigTf[1]
newShort = shortTrigTf and not shortTrigTf[1]

// Filtre RSI : autorise uniquement si rsiLower <= RSI <= rsiUpper
rsiOk = rsiTf >= rsiLower and rsiTf <= rsiUpper

// Cooldown apres une entree
var int lastEntryBar = -10000
cooldownOk = not useCooldown or (bar_index - lastEntryBar) >= cooldownBars

longSignal  = newLong  and rsiOk and cooldownOk
shortSignal = newShort and rsiOk and cooldownOk


// ============================================================
//                  POSITION SIZING (x200)
// ============================================================
//  Marge x Levier = valeur notionnelle reelle du contrat perp.

marginUsd = strategy.equity * qtyPct / 100.0
qtyUnits  = math.max((marginUsd * levInfo) / close, 0.0)


// ============================================================
//                       EXECUTION
// ============================================================

if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty = qtyUnits)
    strategy.exit("XL", from_entry = "Long",
                  limit = close * (1 + tpPct / 100.0),
                  stop  = close * (1 - slPct / 100.0))
    lastEntryBar := bar_index

if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = qtyUnits)
    strategy.exit("XS", from_entry = "Short",
                  limit = close * (1 - tpPct / 100.0),
                  stop  = close * (1 + slPct / 100.0))
    lastEntryBar := bar_index


// ============================================================
//                         VISUELS
// ============================================================

plot(hhTf, title = "Canal Haut (HH)", color = color.new(color.lime, 30), linewidth = 1)
plot(llTf, title = "Canal Bas (LL)",  color = color.new(color.red,  30), linewidth = 1)

plotshape(longSignal,  title = "Long Breakout",  style = shape.triangleup,
          location = location.belowbar, color = color.new(color.lime, 0), size = size.small)
plotshape(shortSignal, title = "Short Breakout", style = shape.triangledown,
          location = location.abovebar, color = color.new(color.red,  0), size = size.small)


// ============================================================
//                         ALERTES
// ============================================================

alertcondition(longSignal,  title = "LONG breakout",  message = "BREAKOUT LONG SOLUSDT.P @ {{close}}")
alertcondition(shortSignal, title = "SHORT breakout", message = "BREAKOUT SHORT SOLUSDT.P @ {{close}}")
