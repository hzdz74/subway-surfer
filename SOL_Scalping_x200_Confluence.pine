//@version=5
// ============================================================
//  SOL Dow Breakout x200 - RSI Filter Strategy (v3 - durcie)
//
//  THEORIE DE DOW APPLIQUEE A L'EXECUTION
//  --------------------------------------
//  1) TENDANCE PRIMAIRE (TF macro)
//     - Bull : Higher High ET Higher Low  (HH-HL)
//     - Bear : Lower  High ET Lower  Low  (LH-LL)
//     - Indecis -> 0 trade
//  2) CONFIRMATION VOLUME (Dow #5) : volume > MA(volume) x facteur
//  3) EXECUTION DANS LE SENS : long en Bull, short en Bear, jamais contre
//  4) RSI [30 ; 70] = anti-epuisement (phase 3 distribution/accumulation)
//
//  Cibles : TP +0.125% = +25% ROE x200
//           SL -0.0625% = -12.5% ROE (R/R 2:1)
//           Liquidation ~ -0.5% prix
//
//  CORRECTIF v3 :
//   - var sorti des fonctions appelees par request.security
//   - tracking d'etat des pivots au niveau chart (plus fiable en v5)
//   - extraction de signaux bruts via security, agregation locale
// ============================================================

strategy(
     title                   = "SOL Dow Breakout x200 - RSI Filter",
     shorttitle              = "SOL Dow x200",
     overlay                 = true,
     initial_capital         = 1000,
     currency                = currency.USD,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.05,
     slippage                = 2,
     margin_long             = 0.5,
     margin_short            = 0.5,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true)


// ============================================================
//                           INPUTS
// ============================================================

// 0. Timeframes
tfExec  = input.timeframe("5",  "TF Execution (scalping)",
                                options = ["1", "5"], group = "0. Timeframes",
                                tooltip = "TF des bougies de declenchement (1m ou 5m).")
tfMacro = input.timeframe("60", "TF Macro (tendance primaire Dow)",
                                options = ["15", "30", "60", "240"], group = "0. Timeframes",
                                tooltip = "TF ou la Theorie de Dow identifie la tendance majeure. Doit etre > TF d'execution.")

// 1. Dow Theory
pivotLen = input.int(5, "Largeur pivot (gauche & droite)",
                        group = "1. Dow Theory", minval = 2,
                        tooltip = "Bougies a gauche ET a droite pour valider un pivot. 3 = reactif, 5 = robuste, 10 = swing strict.")

// 2. Breakout (Donchian)
breakoutLen = input.int(20, "Longueur du canal HH/LL",
                            group = "2. Breakout", minval = 2)

// 3. RSI
rsiLen   = input.int(14,   "Periode RSI",                   group = "3. RSI Filter", minval = 2)
rsiLower = input.float(30, "Borne basse RSI (interdit si <)",group = "3. RSI Filter", step = 1, minval = 0, maxval = 100)
rsiUpper = input.float(70, "Borne haute RSI (interdit si >)",group = "3. RSI Filter", step = 1, minval = 0, maxval = 100)

// 4. Volume
useVol   = input.bool(true, "Volume doit confirmer (Dow #5)", group = "4. Volume")
volMaLen = input.int(20,    "MA du volume",                   group = "4. Volume", minval = 1)
volMult  = input.float(1.3, "Volume requis x MA",             group = "4. Volume", step = 0.1, minval = 1.0)

// 5. Risk
tpPct = input.float(0.125, "Take Profit %  (+25% ROE @ x200)",
                           group = "5. Risque", step = 0.005, minval = 0.001)
slPct = input.float(0.0625,"Stop Loss %  (-12.5% ROE, R/R 2:1)",
                           group = "5. Risque", step = 0.005, minval = 0.001)

// 6. Sizing
qtyPct  = input.float(10,  "Marge par trade (% equity)",    group = "6. Sizing", step = 1, minval = 0.1)
levInfo = input.float(200, "Levier (sizing notionnel)",     group = "6. Sizing", minval = 1)

// 7. Pacing
useCooldown  = input.bool(true, "Cooldown entre trades",    group = "7. Pacing")
cooldownBars = input.int(2,     "Cooldown (bougies)",       group = "7. Pacing", minval = 0)


// ============================================================
//      MACRO TF : extraction des pivots bruts (sans var)
// ============================================================

f_pivots() =>
    ph = ta.pivothigh(high, pivotLen, pivotLen)
    pl = ta.pivotlow(low,   pivotLen, pivotLen)
    [ph, pl]

[macroPh, macroPl] = request.security(syminfo.tickerid, tfMacro, f_pivots(),
                                       lookahead = barmerge.lookahead_off)


// ============================================================
//      DOW STATE TRACKING (au niveau chart, fiable)
// ============================================================

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na

// Detection du front montant : nouveau pivot des qu'une nouvelle
// valeur arrive (transition na->valeur OU changement de valeur).
newPH = not na(macroPh) and (na(macroPh[1]) or macroPh != macroPh[1])
newPL = not na(macroPl) and (na(macroPl[1]) or macroPl != macroPl[1])

if newPH
    prevPH := lastPH
    lastPH := macroPh

if newPL
    prevPL := lastPL
    lastPL := macroPl

dowBull = not na(prevPH) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
dowBear = not na(prevPH) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL


// ============================================================
//   EXEC TF : breakout, RSI, volume (sans var dans la fct)
// ============================================================

f_exec() =>
    hh        = ta.highest(high, breakoutLen)[1]   // [1] = exclure la bougie courante
    ll        = ta.lowest(low,   breakoutLen)[1]
    rsi       = ta.rsi(close, rsiLen)
    volMa     = ta.sma(volume, volMaLen)
    longTrig  = ta.crossover(close,  hh)
    shortTrig = ta.crossunder(close, ll)
    volSpike  = volume > volMa * volMult
    [hh, ll, rsi, longTrig, shortTrig, volSpike]

[hhExec, llExec, rsiExec, longTrigE, shortTrigE, volSpikeE] = request.security(syminfo.tickerid, tfExec, f_exec(),
                                                                                lookahead = barmerge.lookahead_off)


// ============================================================
//                  CONDITIONS FINALES
// ============================================================

// Detection du flanc montant (1 seule entree par cassure)
newLong  = longTrigE  and not longTrigE[1]
newShort = shortTrigE and not shortTrigE[1]

rsiOk = rsiExec >= rsiLower and rsiExec <= rsiUpper
volOk = not useVol or volSpikeE

var int lastEntryBar = -10000
cooldownOk = not useCooldown or (bar_index - lastEntryBar) >= cooldownBars

longSignal  = dowBull and newLong  and rsiOk and volOk and cooldownOk
shortSignal = dowBear and newShort and rsiOk and volOk and cooldownOk


// ============================================================
//                  POSITION SIZING (x200)
// ============================================================

marginUsd = strategy.equity * qtyPct / 100.0
qtyUnits  = math.max((marginUsd * levInfo) / close, 0.0)


// ============================================================
//                       EXECUTION
// ============================================================

if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty = qtyUnits)
    strategy.exit("XL", from_entry = "Long",
                  limit = close * (1 + tpPct / 100.0),
                  stop  = close * (1 - slPct / 100.0))
    lastEntryBar := bar_index

if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = qtyUnits)
    strategy.exit("XS", from_entry = "Short",
                  limit = close * (1 - tpPct / 100.0),
                  stop  = close * (1 + slPct / 100.0))
    lastEntryBar := bar_index


// ============================================================
//                         VISUELS
// ============================================================

plot(hhExec, title = "Canal HH (exec)", color = color.new(color.lime, 40), linewidth = 1)
plot(llExec, title = "Canal LL (exec)", color = color.new(color.red,  40), linewidth = 1)

plot(lastPH, title = "Dow HH (macro)", color = color.new(color.aqua,    0), linewidth = 2, style = plot.style_circles)
plot(lastPL, title = "Dow LL (macro)", color = color.new(color.fuchsia, 0), linewidth = 2, style = plot.style_circles)

bgcolor(dowBull ? color.new(color.lime, 92) : dowBear ? color.new(color.red, 92) : na, title = "Etat Dow")

plotshape(longSignal,  title = "Long (Dow Bull + Breakout)",  style = shape.triangleup,
          location = location.belowbar, color = color.new(color.lime, 0), size = size.small)
plotshape(shortSignal, title = "Short (Dow Bear + Breakout)", style = shape.triangledown,
          location = location.abovebar, color = color.new(color.red,  0), size = size.small)


// ============================================================
//                         ALERTES
// ============================================================

alertcondition(longSignal,  title = "LONG Dow Breakout",  message = "Dow Bull + Breakout LONG SOLUSDT.P @ {{close}}")
alertcondition(shortSignal, title = "SHORT Dow Breakout", message = "Dow Bear + Breakout SHORT SOLUSDT.P @ {{close}}")
