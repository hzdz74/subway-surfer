//@version=5
// ============================================================
//  SOL Scalping x200 - Confluence Strategy (v2 - durcie)
//  Asset      : SOLUSDT.P
//  Timeframes : 1m or 5m (sélection dans la barre TV)
//  Leverage   : x200  -> TP +0.125% = +25% ROE
//                       SL -0.25%   = -50% ROE  (R/R 1:2)
//                       Liquidation a ~ -0.5% prix
// ============================================================

strategy(
     title                   = "SOL Scalping x200 - Confluence",
     shorttitle              = "SOL Scalp x200",
     overlay                 = true,
     initial_capital         = 1000,
     currency                = currency.USD,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.04,
     slippage                = 2,
     margin_long             = 0.5,
     margin_short            = 0.5,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true)


// ============================================================
//                           INPUTS
// ============================================================

// 1. Session / pacing
useSession   = input.bool(false,         "Filtrer par session",        group = "1. Session")
sessionStr   = input.session("0000-2359","Session UTC (HHmm-HHmm)",    group = "1. Session")
useCooldown  = input.bool(true,          "Cooldown entre trades",      group = "1. Session")
cooldownBars = input.int(3,              "Cooldown (bougies)",         group = "1. Session", minval = 0)

// 2. Trend filter
useEma   = input.bool(true, "Activer Double EMA",    group = "2. Tendance")
emaFastL = input.int(9,     "EMA rapide",            group = "2. Tendance", minval = 1)
emaSlowL = input.int(21,    "EMA lente",             group = "2. Tendance", minval = 1)
useVwap  = input.bool(true, "Activer VWAP",          group = "2. Tendance")

// 3. Momentum trigger
rsiLen      = input.int(7,    "Longueur RSI",                 group = "3. Momentum", minval = 2)
rsiLongLvl  = input.float(40, "RSI niveau LONG (cross above)",group = "3. Momentum", step = 1)
rsiShortLvl = input.float(60, "RSI niveau SHORT (cross below)",group = "3. Momentum", step = 1)

// 4. Volatility
atrLen    = input.int(14,    "Longueur ATR",              group = "4. Volatilite", minval = 1)
useAtr    = input.bool(true, "Filtrer faible volatilite", group = "4. Volatilite")
minAtrPct = input.float(0.05,"ATR min en % du prix",      group = "4. Volatilite", step = 0.01)

// 5. Volume
useVol   = input.bool(true, "Confirmer par volume",      group = "5. Volume")
volMaLen = input.int(20,    "Longueur MA volume",        group = "5. Volume", minval = 1)
volMult  = input.float(1.2, "Multiplicateur volume",     group = "5. Volume", step = 0.1)

// 6. Risk management
tpPct   = input.float(0.125, "Take Profit %  (+25% ROE x200)",  group = "6. Risque", step = 0.005, minval = 0.001)
slPct   = input.float(0.25,  "Stop Loss %  (-50% ROE, R/R 1:2)",group = "6. Risque", step = 0.005, minval = 0.001)
qtyPct  = input.float(10,    "Marge par trade (% equity)",      group = "6. Risque", step = 1,     minval = 0.1)
levInfo = input.float(200,   "Levier (sizing notionnel)",       group = "6. Risque", minval = 1)


// ============================================================
//                        INDICATEURS
// ============================================================

emaFast = ta.ema(close, emaFastL)
emaSlow = ta.ema(close, emaSlowL)
vwapVal = ta.vwap(hlc3)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
atrPct  = atrVal / close * 100.0
volMa   = ta.sma(volume, volMaLen)


// ============================================================
//                        CONDITIONS
// ============================================================

inSession = not useSession or not na(time(timeframe.period, sessionStr))

trendUp = (not useEma  or (emaFast > emaSlow and close > emaFast)) and (not useVwap or close > vwapVal)
trendDn = (not useEma  or (emaFast < emaSlow and close < emaFast)) and (not useVwap or close < vwapVal)

rsiLongTrig  = ta.crossover(rsiVal,  rsiLongLvl)
rsiShortTrig = ta.crossunder(rsiVal, rsiShortLvl)

volOk  = not useVol or volume > volMa * volMult
volaOk = not useAtr or atrPct >= minAtrPct

var int lastEntryBar = -10000
cooldownOk = not useCooldown or (bar_index - lastEntryBar) >= cooldownBars

longSignal  = trendUp and rsiLongTrig  and volOk and volaOk and inSession and cooldownOk
shortSignal = trendDn and rsiShortTrig and volOk and volaOk and inSession and cooldownOk


// ============================================================
//                     POSITION SIZING (x200)
// ============================================================
//  Marge x Levier = valeur notionnelle reelle du contrat perp.

marginUsd = strategy.equity * qtyPct / 100.0
qtyUnits  = math.max((marginUsd * levInfo) / close, 0.0)


// ============================================================
//                       EXECUTION
// ============================================================
//  L'exit est attache a l'entree dans le meme bloc :
//  Pine utilise `close` comme proxy fiable du prix d'execution
//  car process_orders_on_close = true.

if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long, qty = qtyUnits)
    strategy.exit("XL", from_entry = "Long",
                  limit = close * (1 + tpPct / 100.0),
                  stop  = close * (1 - slPct / 100.0))
    lastEntryBar := bar_index

if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short, qty = qtyUnits)
    strategy.exit("XS", from_entry = "Short",
                  limit = close * (1 - tpPct / 100.0),
                  stop  = close * (1 + slPct / 100.0))
    lastEntryBar := bar_index


// ============================================================
//                         VISUELS
// ============================================================

plot(useEma  ? emaFast : na, title = "EMA Fast", color = color.new(color.yellow, 0))
plot(useEma  ? emaSlow : na, title = "EMA Slow", color = color.new(color.orange, 0), linewidth = 2)
plot(useVwap ? vwapVal : na, title = "VWAP",     color = color.new(color.aqua,   0), linewidth = 2)

plotshape(longSignal,  title = "Long",  style = shape.triangleup,
          location = location.belowbar, color = color.new(color.lime, 0), size = size.tiny)
plotshape(shortSignal, title = "Short", style = shape.triangledown,
          location = location.abovebar, color = color.new(color.red,  0), size = size.tiny)


// ============================================================
//                         ALERTES
// ============================================================

alertcondition(longSignal,  title = "LONG entry",  message = "LONG SOLUSDT.P @ {{close}}")
alertcondition(shortSignal, title = "SHORT entry", message = "SHORT SOLUSDT.P @ {{close}}")
