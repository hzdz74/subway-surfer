# ── Stripe ──────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...

# Dashboard → Products → create "MedAssist Pro" → copy price ID
STRIPE_PRO_PRICE_ID=price_...

# Dashboard → Products → create "MedAssist Enterprise" → copy price ID
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Dashboard → Developers → Webhooks → Add endpoint → copy signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ── BioDigital Human ─────────────────────────────────────────────────
# developer.biodigital.com → Create App → copy Developer Key
NEXT_PUBLIC_BIODIGITAL_KEY=your_developer_key_here

# Optional: override default model IDs
# NEXT_PUBLIC_BIODIGITAL_MALE_MODEL=production/maleAdult/male_complete_anatomy_16
# NEXT_PUBLIC_BIODIGITAL_FEMALE_MODEL=production/femaleAdult/female_complete_anatomy_10
